<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>FingerprintAgent.Tests</RootNamespace>
    <AssemblyName>FingerprintAgent.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FingerprintAgent\FingerprintAgent.csproj" />
    <!-- WixCA alias lets tests disambiguate ConfigMerger which is linked (and therefore duplicated) into
         the Installer assembly. Without an alias, references to ConfigMerger become ambiguous. -->
    <ProjectReference Include="..\..\src\FingerprintAgent.Installer\FingerprintAgent.Installer.csproj" Aliases="WixCA" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
