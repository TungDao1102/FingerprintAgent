<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>FingerprintAgent</RootNamespace>
    <AssemblyName>FingerprintAgent.Library</AssemblyName>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <!--
      WARN-11: explicit Version/AssemblyVersion/VersionPrefix keeps the version surfaced
      by Assembly.GetExecutingAssembly() (used by UpdateCheckService for currentVersion
      comparison) stable across local dev builds (no /p:Version flag) and CI builds
      (/p:Version=1.0.1). Without explicit values, SDK defaults to 1.0.0 for both Local
      and Release, and the e2e build (/p:Version=0.0.0-e2e) drops the suffix to 0.0.0
      which would erroneously trigger an update against any release tag >= 0.0.0.
    -->
    <Version>0.1.0</Version>
    <VersionPrefix>0.1.0</VersionPrefix>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <SecuGenSdkPresent Condition="Exists('$(MSBuildProjectDirectory)\..\..\lib\SecuGen\SecuGen.FDxSDKPro.Windows.dll')">true</SecuGenSdkPresent>
    <ZKTecoSdkPresent Condition="Exists('$(MSBuildProjectDirectory)\..\..\lib\ZKTeco\libzkfp.dll')">true</ZKTecoSdkPresent>
    <DigitalPersonaSdkPresent Condition="Exists('$(MSBuildProjectDirectory)\..\..\lib\DigitalPersona\DPFPDevNET.dll')">true</DigitalPersonaSdkPresent>
    <FutronicSdkPresent Condition="Exists('$(MSBuildProjectDirectory)\..\..\lib\Futronic\ftrScanAPI.dll')">true</FutronicSdkPresent>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ZKTecoSdkPresent)' == 'true'">
    <DefineConstants>$(DefineConstants);ZKTECO_SDK_PRESENT</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SecuGenSdkPresent)' == 'true'">
    <DefineConstants>$(DefineConstants);SECUGEN_SDK_PRESENT</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DigitalPersonaSdkPresent)' == 'true'">
    <DefineConstants>$(DefineConstants);DIGITALPERSONA_SDK_PRESENT</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(FutronicSdkPresent)' == 'true'">
    <DefineConstants>$(DefineConstants);FUTRONIC_SDK_PRESENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(SecuGenSdkPresent)' == 'true'">
    <Reference Include="SecuGen.FDxSDKPro.Windows">
      <HintPath>$(MSBuildProjectDirectory)\..\..\lib\SecuGen\SecuGen.FDxSDKPro.Windows.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(DigitalPersonaSdkPresent)' == 'true'">
    <Reference Include="DPFPDevNET">
      <HintPath>$(MSBuildProjectDirectory)\..\..\lib\DigitalPersona\DPFPDevNET.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- REVIEW FIX (02-02): Digital Persona U.are.U SDK via DPUruNet wrapper. The native DLLs
         (DPFPDevNET.dll, DPFPCapture.dll, etc.) come from the vendor SDK download and must be
         placed in lib/DigitalPersona/ — document in SCANNER_SETUP.md. Pin to 1.0.0.1 (offline cache). -->
    <PackageReference Include="DPUruNet" Version="1.0.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- REVIEW FIX (NuGet supply-chain): Pin to EXACT version 1.2.1 — do not use floating version. If NuGet feed defaults change, pinned version prevents unexpected updates. -->
    <PackageReference Include="ZkTecoFingerPrint" Version="1.2.1" />
    <!-- REVIEW FIX (fallback): If ZkTecoFingerPrint NuGet is abandoned or compromised, fall back to raw zkfp2 P/Invoke documented in 02-RESEARCH.md §5 Option A. Document this in SCANNER_SETUP.md "ZKTeco Fallback" section. -->
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config.template.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
