<?xml version="1.0" encoding="utf-8"?>
<!--
  CustomAction.config is packed into FingerprintAgent.Installer.CA.dll by MakeSfxCA
  (DTF packs @(Content)) and read by the SfxCA shim when it starts a CLR for the
  managed custom actions.

  useLegacyV2RuntimeActivationPolicy="true" is REQUIRED: without it the shim's CLR
  activation fails on Windows 11 24H2 / Windows Server 2025 with
  "SFXCA: Failed to get requested CLR info. Error code 0x80131700", making every
  custom action return 1603. This matches the guidance printed by SfxCA itself and
  the stock DTF CustomAction.config template.
-->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
