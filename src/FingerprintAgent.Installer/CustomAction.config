<?xml version="1.0" encoding="utf-8"?>
<!--
  CustomAction.config tells msiexec.exe to load this CustomAction DLL into the
  .NET Framework 4.8 CLR. Without this config, msiexec defaults to .NET 2.0 CLR
  and CustomAction code using net48-only features throws TypeLoadException at install time.

  The DTF wrapper (FingerprintAgent.Installer.CA.dll) is the type-1 CustomAction that
  msiexec loads; this config file is loaded by the managed CustomAction runtime to
  bind to the correct .NET version.
-->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
