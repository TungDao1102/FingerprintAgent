<?xml version="1.0" encoding="utf-8"?>
<!--
  WixUI_Minimal.vi-VN.wxl — Vietnamese strings for WixUI_Minimal + the custom VcRedist dialog.

  Only override IDs the UIExtension dialogs actually reference (wix3 wixlib):
    - Fresh install flow : WelcomeEulaDlg -> ProgressDlg -> ExitDialog
    - Patch installs     : WelcomeDlg (rarely seen; kept for completeness)
    - Also linked        : ErrorDlg, MsiRMFilesInUse, UserExit, ResumeDlg, PrepareDlg,
                           FatalError, FilesInUse (button labels below cover their texts)
  Strings not referenced by any of those dialogs were removed (InstallDlgTitle,
  InstallScopeDlgTitle, FinishedDlg*, WixUIInstall) — they belong to other UI sets.

  Codepage="65001" (UTF-8) is REQUIRED for this database: Windows-1258 has no
  single-byte (precomposed) form for many Vietnamese vowels used here
  (ế ề ệ ộ ứ ữ ậ ố …), so light rejects every such string with LGHT0311.
  With -loc, the WixLocalization codepage wins over Product/@Codepage, so it
  must be set here (and mirrored on Product).
-->
<WixLocalization Culture="vi-VN" Codepage="65001" xmlns="http://schemas.microsoft.com/wix/2006/localization">

  <!-- WelcomeEulaDlg — first dialog on a fresh install -->
  <String Id="WelcomeEulaDlgTitle">{\WixUI_Font_Title}Giấy phép sử dụng Fingerprint Agent</String>
  <String Id="WelcomeEulaDlgLicenseAcceptedCheckBox">Tôi &amp;đồng ý với các điều khoản cấp phép</String>
  <String Id="WelcomeEulaDlgInstall">Cài đặt</String>

  <!-- WelcomeDlg — patch installs only -->
  <String Id="WelcomeDlgTitle">{\WixUI_Font_Title}Chào mừng đến với Trình cài đặt Fingerprint Agent</String>
  <String Id="WelcomeDlgDescription">Trình cài đặt sẽ cập nhật Fingerprint Agent trên máy tính của bạn. Nhấn Tiếp tục để bắt đầu.</String>

  <!-- ProgressDlg -->
  <String Id="ProgressDlgTitle">Đang cài đặt Fingerprint Agent</String>
  <String Id="ProgressDlgTextInstalling">Đang cài đặt, vui lòng đợi...</String>

  <!-- ExitDialog -->
  <String Id="ExitDialogTitle">{\WixUI_Font_Title}Cài đặt hoàn tất</String>
  <String Id="ExitDialogDescription">Fingerprint Agent đã được cài đặt và dịch vụ đã khởi động. Nhấn Hoàn tất để đóng trình cài đặt.</String>

  <!-- Shared button labels -->
  <String Id="WixUIOk">Đồng ý</String>
  <String Id="WixUICancel">Hủy</String>
  <String Id="WixUINext">Tiếp tục &gt;</String>
  <String Id="WixUIBack">&lt; Quay lại</String>
  <String Id="WixUIFinish">&amp;Hoàn tất</String>
  <String Id="WixUIClose">Đóng</String>
  <String Id="WixUIYes">Có</String>
  <String Id="WixUINo">Không</String>
  <String Id="WixUIPrint">&amp;In</String>

  <!-- VcRedistErrorDialog (custom dialog, DialogRef'd from FingerprintAgent.Installer.wxs) -->
  <String Id="VcRedistErrorTitle">Thiếu Microsoft Visual C++ Redistributable (x86)</String>
  <String Id="VcRedistErrorBody">Máy tính này chưa cài Microsoft Visual C++ Redistributable (x86) — thành phần cần thiết để FingerprintAgent hoạt động.[BR][BR]Vui lòng tải và cài đặt từ:[BR]https://aka.ms/vs/17/release/vc_redist.x86.exe[BR][BR]Sau đó chạy lại trình cài đặt này.</String>

</WixLocalization>
