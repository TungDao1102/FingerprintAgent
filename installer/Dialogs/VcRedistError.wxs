<?xml version="1.0"?>
<!--
  VcRedistError.wxs — Vietnamese error dialog for missing VC++ x86 runtime.

  TRIGGER
    CheckVcRedist CA sets session property `VcRedistMissingDialog = "1"` when VC++ x86
    is not detected. Authored dialogs cannot be displayed from the execute sequence, so
    the CA shows the same loc text via Session.Message instead (CR-07 follow-up — text
    from the VcRedistErrorTitleText / VcRedistErrorBodyText properties). This authored
    dialog ships in the MSI for a future UI-sequence display path.

  CONTENT (per D-11)
    Title: Thiếu Microsoft Visual C++ Redistributable (x86)
    Body:  Vietnamese text with download URL https://aka.ms/vs/17/release/vc_redist.x86.exe

  WIRING
    This Fragment exposes the Dialog Id. The main .wxs references it via <DialogRef>.
    Actual display is scheduled in main .wxs InstallUISequence (TODO: Phase 5+).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Fragment>

    <!--
      Strings come from WixUI_Minimal.vi-VN.wxl (VcRedistErrorTitle / VcRedistErrorBody);
      the same loc strings feed the Session.Message notice via the VcRedistErrorTitleText /
      VcRedistErrorBodyText properties declared in FingerprintAgent.Installer.wxs.
    -->
    <UI>
      <Dialog Id="VcRedistErrorDialog"
              Width="370"
              Height="270"
              Title="!(loc.VcRedistErrorTitle)">

        <Control Id="lbl_Title"
                 Type="Text"
                 X="20" Y="20"
                 Width="330" Height="30"
                 Text="!(loc.VcRedistErrorTitle)"
                 Transparent="yes" />

        <Control Id="lbl_Body"
                 Type="Text"
                 X="20" Y="60"
                 Width="330" Height="120"
                 Text="!(loc.VcRedistErrorBody)" />

        <Control Id="btn_Ok"
                 Type="PushButton"
                 X="280" Y="230"
                 Width="80" Height="20"
                 Text="!(loc.WixUIOk)"
                 Default="yes"
                 Cancel="yes">
          <Publish Event="EndDialog" Value="Return" />
        </Control>

      </Dialog>
    </UI>

  </Fragment>
</Wix>
