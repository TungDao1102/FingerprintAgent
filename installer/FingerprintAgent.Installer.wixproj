<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    FingerprintAgent.Installer.wixproj — WiX 3.x MSBuild project (non-SDK style).

    WHY NOT SDK STYLE
      WiX 3.x (3.14.x) does not ship a WixToolset.Sdk NuGet package. The 4.0+ SDK is the
      only available WixToolset.Sdk package on NuGet, but its compiler rejects v3 schema
      .wxs files. To use WiX 3.x schema, we must use the legacy wix.targets import.

    REQUIRED ENVIRONMENT
      WixToolPath MSBuild property must point at the WiX 3.x install (e.g., C:\wix314\).
      Set via: dotnet build /p:WixToolPath=C:\wix314\
      CI sets this automatically after installing WiX 3.14.1 from
      https://github.com/wixtoolset/wix3/releases/tag/wix3141rtm (wix314-binaries.zip).

    The CI workflow (.github/workflows/release.yml) downloads the binaries and invokes
    dotnet build with WixToolPath set. Local developers must install WiX 3.x manually
    (download wix314.exe from the same release page) to build the MSI locally.
  -->
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform>x86</Platform>
    <ProductVersion>3.10</ProductVersion>
    <SchemaVersion>3.0.6020.0</SchemaVersion>
    <OutputName>FingerprintAgent-Setup</OutputName>
    <OutputType>Package</OutputType>
    <!-- Default when the caller doesn't set one (must precede MsiProductVersion). -->
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <!--
      MSI ProductVersion must be x[.x[.x[.x]]] with integer segments 0-65534 —
      candle rejects semver suffixes with CNDL0108 ("'0.0.0-e2e' is not a valid
      version"). Strip any prerelease (-e2e / -dev / -rc1) or build-metadata
      (+build) suffix so workflows can pass git-tag-style versions verbatim.
    -->
    <MsiProductVersion>$([System.String]::Copy('$(Version)').Split('-')[0].Split('+')[0])</MsiProductVersion>
    <MsiProductVersion Condition="'$(MsiProductVersion)' == ''">0.1.0</MsiProductVersion>
    <!--
      DefineConstants only carries Version; ProductCode/UpgradeCode live as <?define ?>
      inside FingerprintAgent.Installer.wxs (single source of truth, no -d duplication
      that could drift from the in-file definitions).
    -->
    <DefineConstants>Version=$(MsiProductVersion)</DefineConstants>
    <!-- Don't auto-include .cs files as compile items; this project only orchestrates candle.exe. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!--
      OutputPath MUST live in the top-level PropertyGroup (not inside the Build target).
      wix.targets declares InitialTargets="_CheckForInvalidConfigurationAndPlatform"
      which reads $(OutputPath) during global evaluation, before any user target runs.
      Properties declared inside <Target><PropertyGroup> are only visible during that
      target's execution, so the check would fail with:
        "The OutputPath property is not set for this project. Configuration='Release' Platform='x86'"
      from C:\wix314\wix.targets(473,7).
    -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <Import Project="$(WixToolPath)\wix.targets" Condition="Exists('$(WixToolPath)\wix.targets')" />

  <ItemGroup>
    <!-- WiX 3.x uses <Compile> as a WiX item type (NOT MSBuild Compile). Listed here so
         candle.exe can find the source files when imported wix.targets processes them. -->
    <Compile Include="FingerprintAgent.Installer.wxs" />
    <Compile Include="Components\ProductComponents.wxs" />
    <Compile Include="Components\Service.wxs" />
    <Compile Include="Components\ProgramDataConfig.wxs" />
    <Compile Include="Components\CustomActions.wxs" />
    <Compile Include="Components\UninstallBehavior.wxs" />
    <Compile Include="Dialogs\VcRedistError.wxs" />
  </ItemGroup>

  <ItemGroup>
    <WixLocalization Include="Dialogs\WixUI_Minimal.vi-VN.wxl" Culture="vi-VN" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\FingerprintAgent.Installer\FingerprintAgent.Installer.csproj">
      <Name>FingerprintAgent.Installer</Name>
      <Private>true</Private>
    </ProjectReference>
    <ProjectReference Include="..\src\FingerprintAgent.Host\FingerprintAgent.Host.csproj">
      <Name>FingerprintAgent.Host</Name>
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="Build" Outputs="bin\$(Configuration)\$(OutputName).msi">
    <!--
      candle.exe (Compile) + light.exe (Link) invocations.
      The wix.targets import above provides the standard WiX 3.x Compile/Link targets.
      We just need to wire up the bin directory and dependency on the source files.
    -->
    <PropertyGroup>
      <WixToolDir>$([MSBuild]::EnsureTrailingSlash('$(WixToolPath)'))</WixToolDir>
      <CandlePath>$(WixToolDir)candle.exe</CandlePath>
      <LightPath>$(WixToolDir)light.exe</LightPath>
      <!--
        C2 fix: Service.wxs / CustomActions.wxs reference $(var.FingerprintAgent.Host.TargetDir)
        and $(var.FingerprintAgent.Installer.TargetDir). The standard wix.targets machinery that
        normally defines those variables is bypassed by this hand-rolled Build target, so we
        derive them from the solution's fixed layout (dotnet build FingerprintAgent.sln runs
        first in CI and locally) and feed them to candle explicitly.
      -->
      <HostTargetDir>$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)\..\src\FingerprintAgent.Host\bin\$(Configuration)\net48'))\</HostTargetDir>
      <InstallerCATargetDir>$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)\..\src\FingerprintAgent.Installer\bin\$(Configuration)'))\</InstallerCATargetDir>
      <!--
        CNDL0117 + CNDL0001 fix: WiX's CLI parser treats a trailing backslash before the
        closing quote as an escape character, so "-o \"bin\Release\"" reads as
        path="bin\Release" with the closing quote consumed and candle keeps consuming
        the source-file list as part of the path (CNDL0117). Stripping the trailing slash
        breaks the opposite way: without it, candle interprets the value as a single
        output file and rejects multiple source files (CNDL0001).

        WiX's own CNDL0117 message recommends the escape form: "C:\Out Directory\\".
        candle's parser unescapes \\ to a single \, leaving the path with a real trailing
        backslash that signals output-directory mode.
      -->
      <CandleOutputDir>bin\$(Configuration)\\</CandleOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <WixSource Include="@(Compile)" />
      <WixObject Include="@(Compile->'$(OutputPath)%(Filename).wixobj')" />
    </ItemGroup>
    <MakeDir Directories="$(OutputPath)" />
    <!--
      I-2: candle.exe requires -dVersion=... on the command line so $(var.Version)
      inside the .wxs files resolves. Without this, <Product Version="$(var.Version)">
      expands to Version="" and candle rejects the empty version with CNDL0009.
      We pass the sanitized $(MsiProductVersion) (numeric x.x.x only — see the
      PropertyGroup above); DefineConstants carries the same value for consistency.
    -->
    <Exec Command="&quot;$(CandlePath)&quot; -ext WixUIExtension -ext WixUtilExtension -dVersion=$(MsiProductVersion) -dFingerprintAgent.Host.TargetDir=&quot;$(HostTargetDir)&quot; -dFingerprintAgent.Installer.TargetDir=&quot;$(InstallerCATargetDir)&quot; -o &quot;$(CandleOutputDir)&quot; @(Compile, ' ')" />
    <Exec Command="&quot;$(LightPath)&quot; -ext WixUIExtension -ext WixUtilExtension -loc &quot;Dialogs\WixUI_Minimal.vi-VN.wxl&quot; -out &quot;$(OutputPath)$(OutputName).msi&quot; @(WixObject, ' ')" />
  </Target>
</Project>
