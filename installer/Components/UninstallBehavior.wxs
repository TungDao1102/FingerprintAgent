<?xml version="1.0"?>
<!--
  UninstallBehavior.wxs — log preservation + REMOVE_LOGS escape hatch.

  DECISIONS
    D-28  Default uninstall preserves C:\ProgramData\FingerprintAgent\Logs\
          (Permanent=yes on the dir Component — see ProgramDataConfig.wxs).
    D-29  `msiexec /x <msi> REMOVE_LOGS=1` removes the Logs directory.
          Implemented via <util:RemoveFolderEx> on a Component that is always
          installed; the CA defers its removal action to when REMOVE_LOGS is set.
    D-30  Graceful service stop handled by ServiceControl in Service.wxs.
    D-31  EventLog source removed on uninstall via util:EventSource RemoveOnUninstall.

  I-3 (REMOVE_LOGS pattern)
    Earlier code used <Condition>REMOVE_LOGS = "1"</Condition> on the Component
    itself. That condition is evaluated at INSTALL time, so with REMOVE_LOGS empty
    during install the Component was never installed — meaning <RemoveFolder On="uninstall">
    could never fire (Component must be installed to participate in uninstall).
    The escape hatch was documented but inert.

    New pattern:
      1. Install the Component unconditionally so it has presence in the package.
      2. Use <util:RemoveFolderEx Property="REMOVE_LOGS_PATH"/> where REMOVE_LOGS_PATH
          is a PATH property (the CA removes whatever full path that property holds),
          set only when the REMOVE_LOGS flag is passed on an already-installed product.
      3. RemoveFolderEx recursively removes the directory (the original RemoveFolder
         only removes if empty, which it never is — logs are present).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <Fragment>

    <!--
      D-29 escape hatch. util:RemoveFolderEx contract (WixCA!WixRemoveFoldersEx,
      immediate CA auto-scheduled at sequence 799): the Property attribute names the
      property whose VALUE is the full path of the folder to remove — it is NOT an
      on/off flag. An empty value makes the CA fail the row with E_INVALIDARG
      (0x80070057), which the auto-generated Return="ignore" swallows; the benign
      "WixRemoveFoldersEx: Missing folder property" line in every verbose log is that
      error path and is unrelated to this feature's health.

      So the path lives in its own property, REMOVE_LOGS_PATH, authored above:
        - Condition "REMOVE_LOGS AND Installed": uninstall/repair only — a fresh
          install must not delete an existing installation's logs even if someone
          passes REMOVE_LOGS=1 to msiexec /i.
        - [LOGS_DIR_PLACEHOLDER] is NOT usable as the value: directory properties
          only resolve at CostFinalize (1000), but the removal CA runs at 799 —
          hence the [PROGRAMDATAFOLDER] Property-table value (D-04, hardcoded,
          no trailing backslash) plus the explicit '\'.
    -->
    <SetProperty Id="REMOVE_LOGS_PATH"
                 Value="[PROGRAMDATAFOLDER]\Logs"
                 Sequence="execute"
                 Before="WixRemoveFoldersEx"><![CDATA[REMOVE_LOGS AND Installed]]></SetProperty>

    <Component Id="cmp_RemoveLogsOnUninstall"
               Guid="{A5B6C7D8-9E0F-1A2B-3C4D-5E6F7A8B9C0D}"
               Win64="no"
               Directory="LOGS_DIR_PLACEHOLDER">
      <util:RemoveFolderEx Property="REMOVE_LOGS_PATH" />
      <!--
        The component has no File/Registry child, so MSI keys it to its directory
        (LOGS_DIR_PLACEHOLDER). ICE18 requires that Directory/Component pair in
        CreateFolders; <CreateFolder/> emits exactly that row (folder already
        exists from cmp_LogsDir, creation is reference-counted and harmless).
      -->
      <CreateFolder />
    </Component>

    <ComponentGroup Id="UninstallBehaviorComponents">
      <ComponentRef Id="cmp_RemoveLogsOnUninstall" />
    </ComponentGroup>

  </Fragment>
</Wix>
