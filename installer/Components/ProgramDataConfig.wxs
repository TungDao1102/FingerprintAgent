<?xml version="1.0"?>
<!--
  ProgramDataConfig.wxs — ProgramData directory + config seed wiring.

  DECISIONS
    D-04  Hard-coded ProgramData path: C:\ProgramData\FingerprintAgent
    D-28  Logs directory preserved on uninstall (Permanent=yes; not removed)
    D-31  EventLog source removed on uninstall (handled by util:EventSource RemoveOnUninstall)
    D-33  Config lives at C:\ProgramData\FingerprintAgent\config.json
    D-34  config.template.json shipped in INSTALLFOLDER as read-only reference
    D-36  First install seeds ProgramData config from template (via SeedProgramDataConfig CA)
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <Fragment>
    <DirectoryRef Id="PROGRAMDATAFOLDER">

      <!--
        D-33/D-36/D-37: ProgramData\FingerprintAgent directory.
        NOT KeyPath because SeedProgramDataConfig CA seeds the file at install time —
        the directory itself just needs to exist (CreateFolder handles that).

        WARN-09: restrict ACL to SYSTEM (full, service runs as LocalSystem per
        Service.wxs:49), Administrators (full, for IT maintenance), and Users (read,
        for operator diagnostics). Previous "Everyone:GenericAll" allowed any local
        user to modify config.json and trigger an auto-update to a malicious repo.
      -->
      <Component Id="cmp_ProgramDataDir" Guid="{D2E3F4A5-6B7C-8D9E-0F1A-2B3C4D5E6F7A}" Win64="no">
        <CreateFolder Directory="PROGRAMDATAFOLDER">
          <util:PermissionEx User="SYSTEM" GenericAll="yes" />
          <util:PermissionEx User="Administrators" GenericAll="yes" />
          <util:PermissionEx User="Users" GenericRead="yes" />
        </CreateFolder>
        <RemoveFolder Id="rmv_ProgramDataDir" On="uninstall" />
      </Component>

      <!--
        D-28: Logs directory preserved on uninstall (Permanent=yes).
        AgentLogger creates the directory at runtime via Directory.CreateDirectory.
        We declare a Component for the dir with Permanent=yes so uninstall leaves it alone.

        WARN-09: same restricted ACL as the parent ProgramData directory.
      -->
      <Component Id="cmp_LogsDir" Guid="{E3F4A5B6-7C8D-9E0F-1A2B-3C4D5E6F7A8B}" Win64="no" Permanent="yes">
        <CreateFolder Directory="LOGS_DIR_PLACEHOLDER">
          <util:PermissionEx User="SYSTEM" GenericAll="yes" />
          <util:PermissionEx User="Administrators" GenericAll="yes" />
          <util:PermissionEx User="Users" GenericRead="yes" />
        </CreateFolder>
      </Component>

    </DirectoryRef>

    <ComponentGroup Id="ProgramDataComponents">
      <ComponentRef Id="cmp_ProgramDataDir" />
      <ComponentRef Id="cmp_LogsDir" />
    </ComponentGroup>

    <!--
      EventLog source — declared as a top-level Component (not nested under INSTALLFOLDER).
      Created during install via util:EventSource, removed on uninstall via RemoveOnUninstall.
    -->
    <Component Id="EventLogSource" Guid="{F4A5B6C7-8D9E-0F1A-2B3C-4D5E6F7A8B9C}" Win64="no">
      <util:EventSource Name="FingerprintAgent"
                        EventLogFile="Application"
                        CategoryMessageFile="[INSTALLFOLDER]FingerprintAgent.exe"
                        SupportsErrors="yes"
                        SupportsInformationals="yes"
                        SupportsWarnings="yes" />
    </Component>

  </Fragment>
</Wix>
