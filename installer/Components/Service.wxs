<?xml version="1.0"?>
<!--
  Service.wxs — service installation + binary files for FingerprintAgent.Host.exe.

  DECISIONS
    D-04  Hard-coded install path: C:\Program Files\FingerprintAgent
    D-19  <ServiceInstall> with Start=auto, Account=LocalSystem, Vital=yes
          + util:ServiceConfig with restart failure actions (matches Install-Service.ps1)
    D-30  <ServiceControl> graceful 30s stop on upgrade (Stop="both" Wait="yes" Timeout="30")
    D-32a Vendor SDK DLLs NOT bundled — production workstations install vendor drivers
          separately; only first-party binaries ship in the MSI.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <!--
        Binaries shipped with MSI (first-party only; no vendor DLLs per D-32a).
        C1 fix: this list MUST mirror src/FingerprintAgent.Host/bin/$(var)/net48 output.
        Previous 4-file list omitted every Microsoft.Extensions*/System.* dependency and
        FingerprintAgent.exe.config (binding redirects) → installed service died on start
        with FileNotFoundException at the first ConfigLoader.Load() JIT. When a NuGet
        reference is added/removed, update this list in the same change.
      -->
      <Component Id="cmp_Binaries" Guid="{B5A2C3D1-7E4F-4A2B-9C8D-1E2F3A4B5C6D}" Win64="no">
        <File Id="fil_AgentExe"
              Source="$(var.FingerprintAgent.Host.TargetDir)FingerprintAgent.exe"
              KeyPath="yes"
              Checksum="yes" />
        <File Id="fil_AgentExeConfig"
              Source="$(var.FingerprintAgent.Host.TargetDir)FingerprintAgent.exe.config" />
        <File Id="fil_AgentLibrary"
              Source="$(var.FingerprintAgent.Host.TargetDir)FingerprintAgent.Library.dll" />
        <File Id="fil_NewtonsoftJson"
              Source="$(var.FingerprintAgent.Host.TargetDir)Newtonsoft.Json.dll" />
        <File Id="fil_DPUruNet"
              Source="$(var.FingerprintAgent.Host.TargetDir)DPUruNet.dll" />
        <File Id="fil_MsBclAsyncInterfaces"
              Source="$(var.FingerprintAgent.Host.TargetDir)Microsoft.Bcl.AsyncInterfaces.dll" />
        <File Id="fil_MsCfgAbstractions"
              Source="$(var.FingerprintAgent.Host.TargetDir)Microsoft.Extensions.Configuration.Abstractions.dll" />
        <File Id="fil_MsCfgBinder"
              Source="$(var.FingerprintAgent.Host.TargetDir)Microsoft.Extensions.Configuration.Binder.dll" />
        <File Id="fil_MsCfg"
              Source="$(var.FingerprintAgent.Host.TargetDir)Microsoft.Extensions.Configuration.dll" />
        <File Id="fil_MsCfgFileExtensions"
              Source="$(var.FingerprintAgent.Host.TargetDir)Microsoft.Extensions.Configuration.FileExtensions.dll" />
        <File Id="fil_MsCfgJson"
              Source="$(var.FingerprintAgent.Host.TargetDir)Microsoft.Extensions.Configuration.Json.dll" />
        <File Id="fil_MsDiAbstractions"
              Source="$(var.FingerprintAgent.Host.TargetDir)Microsoft.Extensions.DependencyInjection.Abstractions.dll" />
        <File Id="fil_MsDi"
              Source="$(var.FingerprintAgent.Host.TargetDir)Microsoft.Extensions.DependencyInjection.dll" />
        <File Id="fil_MsFpAbstractions"
              Source="$(var.FingerprintAgent.Host.TargetDir)Microsoft.Extensions.FileProviders.Abstractions.dll" />
        <File Id="fil_MsFpPhysical"
              Source="$(var.FingerprintAgent.Host.TargetDir)Microsoft.Extensions.FileProviders.Physical.dll" />
        <File Id="fil_MsFsGlobbing"
              Source="$(var.FingerprintAgent.Host.TargetDir)Microsoft.Extensions.FileSystemGlobbing.dll" />
        <File Id="fil_MsPrimitives"
              Source="$(var.FingerprintAgent.Host.TargetDir)Microsoft.Extensions.Primitives.dll" />
        <File Id="fil_SystemBuffers"
              Source="$(var.FingerprintAgent.Host.TargetDir)System.Buffers.dll" />
        <File Id="fil_SystemMemory"
              Source="$(var.FingerprintAgent.Host.TargetDir)System.Memory.dll" />
        <File Id="fil_SystemNumericsVectors"
              Source="$(var.FingerprintAgent.Host.TargetDir)System.Numerics.Vectors.dll" />
        <File Id="fil_SystemRcuUnsafe"
              Source="$(var.FingerprintAgent.Host.TargetDir)System.Runtime.CompilerServices.Unsafe.dll" />
        <File Id="fil_SystemTextEncodingsWeb"
              Source="$(var.FingerprintAgent.Host.TargetDir)System.Text.Encodings.Web.dll" />
        <File Id="fil_SystemTextJson"
              Source="$(var.FingerprintAgent.Host.TargetDir)System.Text.Json.dll" />
        <File Id="fil_SystemThreadingTasksExtensions"
              Source="$(var.FingerprintAgent.Host.TargetDir)System.Threading.Tasks.Extensions.dll" />
        <File Id="fil_SystemValueTuple"
              Source="$(var.FingerprintAgent.Host.TargetDir)System.ValueTuple.dll" />
        <File Id="fil_ConfigTemplate"
              Source="$(var.FingerprintAgent.Host.TargetDir)config.template.json" />
      </Component>
      <!-- Service registration via WiX (D-19) -->
      <Component Id="cmp_Service" Guid="{C1D2E3F4-5A6B-7C8D-9E0F-1A2B3C4D5E6F}" Win64="no">
        <CreateFolder />
        <!--
          Important finding: util:EventSource registration moved to EventLogSource
          Component in ProgramDataConfig.wxs (the canonical location). Removing the
          duplicate here prevents two registry entries for the same EventLog source.
        -->

        <ServiceInstall Id="svc_FingerprintAgent"
                        Name="FingerprintAgent"
                        DisplayName="Fingerprint Agent"
                        Description="Local fingerprint capture service providing HTTP API for web applications"
                        Type="ownProcess"
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Vital="yes"
                        Arguments="--service">
          <util:ServiceConfig
              FirstFailureActionType="restart"
              SecondFailureActionType="restart"
              ThirdFailureActionType="restart"
              RestartServiceDelayInSeconds="5"
              ResetPeriodInDays="1" />
        </ServiceInstall>

        <!--
          D-32a: DelayedAutoStart. WiX 3.x <ServiceInstall> does NOT expose a
          DelayedAutoStart attribute (it was added in WiX 4.x). The Windows-native
          mechanism is a DWORD at
          HKLM\SYSTEM\CurrentControlSet\Services\<Name>\DelayedAutoStart = 1.
          Set it here so the service auto-starts ~2 minutes after boot instead of
          blocking boot on workstations that are slow to initialize the scanner SDK.
        -->
        <RegistryKey Root="HKLM"
                     Key="SYSTEM\CurrentControlSet\Services\FingerprintAgent">
          <RegistryValue Name="DelayedAutoStart" Type="integer" Value="1" />
        </RegistryKey>

        <!-- D-30: graceful 30s stop on upgrade. WiX 3.x <ServiceControl> only exposes
             Wait="yes|no"; the OS-level service stop timeout (default 30s) is what
             actually limits the wait, so Timeout is unsupported and was removed. -->
        <ServiceControl Id="svc_FingerprintAgent_Control"
                        Name="FingerprintAgent"
                        Start="install"
                        Stop="both"
                        Wait="yes"
                        Remove="uninstall" />
      </Component>

    </DirectoryRef>

  </Fragment>
</Wix>
