<?xml version="1.0"?>
<!--
  CustomActions.wxs — CustomAction DLL + four CustomAction declarations.

  BINARY
    The CA DLL produced by src/FingerprintAgent.Installer/. The MSBuild target from
    WixToolset.Dtf.CustomAction wraps the managed DLL into MSI-compatible type-1 format
    with MakeSfxCA.exe post-build. The output filename is FingerprintAgent.Installer.CA.dll.

  CUSTOM ACTIONS
    - DetectInstallType        Schedule: InstallExecuteSequence early (before AppSearch)
    - CheckVcRedist            Schedule: InstallExecuteSequence before InstallValidate (fail-fast)
    - StopRunningService       Schedule: InstallExecuteSequence before InstallFiles (upgrade only)
    - SeedProgramDataConfig    Schedule: InstallExecuteSequence after InstallFiles (write config)
    - SetDelayedAutoStart      Schedule: InstallExecuteSequence after InstallServices (D-32a)
    - ProbeHealthAfterInstall  Schedule: InstallExecuteSequence after StartServices (validate)
    - ArchiveInstallLog        Schedule: after InstallFinalize (success) + rollback (log copy to ProgramData)

  RETURN VALUES
    CheckVcRedist: always Success — warn-only since 2026-09-09 (missing VC++ x86 is logged, install continues)
    ProbeHealthAfterInstall: Failure on rollback
    DetectInstallType / SeedProgramDataConfig: Failure halts install (writes log via session.Log)
    StopRunningService: always Success (failure logged but doesn't block)
    SetDelayedAutoStart: always Success (failure degrades to immediate auto-start, logged)
    ArchiveInstallLog: always Success (best-effort log copy — must never break install/rollback)

  CustomActionData (passed to CAs)
    SeedProgramDataConfig receives:
      InstallTemplatePath  = [INSTALLFOLDER]config.template.json
      ProgramDataConfigPath = [PROGRAMDATAFOLDER]config.json
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Fragment>

    <Binary Id="CustomActionsCA"
            SourceFile="$(var.FingerprintAgent.Installer.TargetDir)FingerprintAgent.Installer.CA.dll" />

    <!-- DetectInstallType: informational only, always returns Success -->
    <CustomAction Id="DetectInstallType"
                  BinaryKey="CustomActionsCA"
                  DllEntry="DetectInstallType"
                  Execute="immediate"
                  Return="check" />

    <!--
      CheckVcRedist: registry probe for VC++ x86. Warn-only since 2026-09-09: when the
      runtime is missing it logs the Vietnamese text and continues — the install is NOT
      blocked. Rationale: import-table audit showed the shipped ZKTeco SDK DLLs are pure
      Win32 (no vcruntime140/msvcp140), so a VC-less machine (e.g. x64 with only the x64
      redist) was being blocked for nothing; the one x86 MSI now targets both 32-bit and
      64-bit Windows. A /MD-linked vendor SDK would fail at load time, not install time.
    -->
    <CustomAction Id="CheckVcRedist"
                  BinaryKey="CustomActionsCA"
                  DllEntry="CheckVcRedist"
                  Execute="immediate"
                  Return="check" />

    <!-- StopRunningService: graceful 30s stop before file replacement on upgrade -->
    <CustomAction Id="StopRunningService"
                  BinaryKey="CustomActionsCA"
                  DllEntry="StopRunningService"
                  Execute="immediate"
                  Return="ignore" />

    <!--
      C5 fix: SeedProgramDataConfig now runs DEFERRED — an immediate CA sequenced after
      InstallFiles executed during script generation, BEFORE files were actually copied,
      so fresh installs failed with FileNotFoundException on the template. Data flows in
      via the Type-51 setter below (DTF exposes it as session.CustomActionData);
      Impersonate=no grants the ProgramData write LocalSystem rights.
    -->
    <CustomAction Id="SetSeedProgramDataConfigData"
                  Property="SeedProgramDataConfig"
                  Value="InstallTemplatePath=[INSTALLFOLDER]config.template.json;ProgramDataConfigPath=[PROGRAMDATAFOLDER]config.json"
                  Execute="immediate"
                  Return="check" />
    <CustomAction Id="SeedProgramDataConfig"
                  BinaryKey="CustomActionsCA"
                  DllEntry="SeedProgramDataConfig"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!--
      D-32a (Error 1409 fix): flips the freshly created service to delayed auto-start.
      Must be deferred — it needs LocalSystem rights and the service created by
      InstallServices (seq 5800) must already exist; sequenced After="InstallServices"
      in FingerprintAgent.Installer.wxs with condition NOT REMOVE. No Type-51 data
      setter required: the service name is the hard-coded ServiceName constant.
      Return=ignore: failure only degrades to immediate auto-start (log-only).
    -->
    <CustomAction Id="SetDelayedAutoStart"
                  BinaryKey="CustomActionsCA"
                  DllEntry="SetDelayedAutoStart"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!--
      Log consolidation: copies the active MSI log (MsiLogFileLocation, guaranteed by the
      MsiLogging property) into [PROGRAMDATAFOLDER]\Logs\install-yyyyMMdd-HHmmss.log so
      install diagnostics sit next to agent.log. Snapshot semantics: MSI keeps writing the
      %TEMP% original after the copy. Always Success — best-effort, never fails an install.
      One DllEntry serves both modes: the immediate success path reads session properties
      directly; the rollback path must receive data via CustomActionData (deferred CAs
      cannot read session properties), hence SetArchiveInstallLogRollbackData (Type-51).
    -->
    <CustomAction Id="ArchiveInstallLog"
                  BinaryKey="CustomActionsCA"
                  DllEntry="ArchiveInstallLog"
                  Execute="immediate"
                  Return="ignore" />

    <CustomAction Id="SetArchiveInstallLogRollbackData"
                  Property="ArchiveInstallLogOnRollback"
                  Value="MsiLogSource=[MsiLogFileLocation];LogTargetDir=[PROGRAMDATAFOLDER]Logs"
                  Execute="immediate"
                  Return="check" />

    <CustomAction Id="ArchiveInstallLogOnRollback"
                  BinaryKey="CustomActionsCA"
                  DllEntry="ArchiveInstallLog"
                  Execute="rollback"
                  Impersonate="no"
                  Return="ignore" />

    <!--
      C5 note: ProbeHealthAfterInstall stays IMMEDIATE (it writes session properties for the
      result dialogs) but is sequenced AFTER InstallFinalize in FingerprintAgent.Installer.wxs —
      immediates placed there run only after the script (incl. StartServices) has executed,
      so the probe sees a genuinely running service. Trade-off: failure surfaces as error
      without file rollback since InstallFinalize already committed.
    -->
    <CustomAction Id="ProbeHealthAfterInstall"
                  BinaryKey="CustomActionsCA"
                  DllEntry="ProbeHealthAfterInstall"
                  Execute="immediate"
                  Return="check" />

    <!--
      StopServiceOnRollback (CR-04): if ProbeHealthAfterInstall fails and MSI rolls back,
      WiX <ServiceControl Stop="both"> only stops on uninstall/upgrade, NOT on rollback.
      The service can be left running on 5043 after a rolled-back install — confusing state.
      This deferred-mode CA explicitly stops the service in the rollback path. Schedules on
      InstallExecuteSequence with condition "Installed" so it only fires when there was
      actually a previous install (the new install has already started the service).
    -->
    <CustomAction Id="StopServiceOnRollback"
                  BinaryKey="CustomActionsCA"
                  DllEntry="StopRunningService"
                  Execute="rollback"
                  Return="ignore" />

    <!--
      StartServiceOnRollback (WARN-10): on a failed UPGRADE, StopRunningService already
      stopped the old service before InstallFiles. If the upgrade fails and rolls back,
      files are restored but the service remains stopped — operator sees "install
      succeeded" (no failure surfaced) and the service won't restart until manual action.
      This CA starts the (now-restored) service in the rollback path. Always Success:
      failure to start logs but doesn't break the rollback.
    -->
    <CustomAction Id="StartServiceOnRollback"
                  BinaryKey="CustomActionsCA"
                  DllEntry="StartServiceAfterRollback"
                  Execute="rollback"
                  Return="ignore" />

  </Fragment>
</Wix>
